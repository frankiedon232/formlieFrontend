/* theme(static): every palette stays available, Appearance may pick any colour for dark mode at run time (leftovers L3). */
@import 'tailwindcss' theme(static);
@import '@nuxt/ui';

/* Classes written in shared/ (e.g. folder colours) must be generated too; Tailwind only scans app/ by default. */
@source '../../../shared';

@theme static {
  /* Closest match to docs/design: slim geometric sans (Onest is the runner-up). */
  --font-sans: 'Manrope', ui-sans-serif, system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;

  /* Motion tokens (auth showcase + page entrance). Used with motion-safe: only. */
  --animate-float: float 7s ease-in-out infinite;
  --animate-float-delayed: float 7s ease-in-out 2.5s infinite;
  --animate-rise: rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  /* Sign-in flow (AuthFlow): response cards drift up and fade; dashes run along the lines. */
  --animate-drift: drift 8s ease-in-out infinite;
  --animate-dash: dash 1.6s linear infinite;

  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -10px;
    }
  }

  @keyframes drift {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    20%,
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-22px);
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -24;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 12px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
