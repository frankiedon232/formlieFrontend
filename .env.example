# Formalie API settings. Copy to .env and fill in. Never commit .env.
# Read by app/core/config.py (pydantic-settings); names are case-insensitive.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | staging | production
APP_RELEASE=0.0.0-dev
DOCS_ENABLED=true                   # /docs and /redoc (always off in production)
# `python -m app.run` starts uvicorn with these (and --no-proxy-headers, which is required)
SERVER_HOST=0.0.0.0
SERVER_PORT=5004
SSL_CERTFILE=C:\devcerts\formalie.pem
SSL_KEYFILE=C:\devcerts\formalie-key.pem

# ── Hosts and tenancy ────────────────────────────────────────────────────────
ROOT_DOMAIN=formalie.dev
MANAGE_SUBDOMAIN=manage
# Peers allowed to set X-Forwarded-For / X-Forwarded-Host / CF-Connecting-IP (Nginx, the Nuxt dev proxy).
TRUSTED_PROXIES=127.0.0.1/32,::1/128
TENANT_CACHE_SECONDS=30

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Superuser, used ONLY by scripts/db_bootstrap.py to create the roles and databases below.
DB_SUPERUSER_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# The user names are fixed (migrations grant to them); choose the passwords.
DB_OWNER_URL=postgresql://formalie_owner:CHANGE_ME@127.0.0.1:5432/formalie       # Alembic only
DB_APP_URL=postgresql://formalie_app:CHANGE_ME@127.0.0.1:5432/formalie           # the API (primary)
DB_RELAY_URL=postgresql://formalie_worker:CHANGE_ME@127.0.0.1:5432/formalie      # outbox relay, partitions
# Read replicas, comma separated (empty = reads go to the primary). Same user as DB_APP_URL.
DB_REPLICA_URLS=
DB_SCHEMA=formaly                    # every workspace table; global tables are in `platform`; nothing in `public`
DB_TEST_DATABASE=formalie_test       # pytest and `alembic -x db=test`
DB_PGBOUNCER=false                   # true when connecting through PgBouncer (transaction pooling)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_READ_YOUR_WRITES_SECONDS=5

# ── Redis, RabbitMQ, Celery (WSL in development) ─────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_BREAKER_SECONDS=15            # Redis unreachable: fail fast this long, then try again
RABBITMQ_URL=amqp://formalie:CHANGE_ME@127.0.0.1:5672/formalie
EVENTS_EXCHANGE=formalie.events
OUTBOX_RELAY_BATCH=200

# ── Secure channel, references, tokens (make them: fmly\Scripts\python.exe scripts\gen_keys.py --write) ──
ID_REF_ENC_KEY=                      # 32 bytes, base64: encrypted references (no id leaves the server as it is)
ID_REF_MAC_KEY=                      # 32 bytes, base64
FERNET_KEYS=                         # newest first, comma separated (rotation): CSRF, access and refresh tokens
SESSION_KEY_TTL_SECONDS=1800
CSRF_TTL_SECONDS=7200

# ── Email (development: Mailpit catches everything, http://127.0.0.1:8025) ──
EMAIL_DELIVERY=celery                # celery (the notifications queue) | direct (send in the request; debugging)
EMAIL_FROM=Formalie <no-reply@formalie.dev>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none                   # none | starttls | tls
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Social sign-in (OAuth). Empty = that button answers "unavailable", as with the mock ──
# Redirect address to register at each provider (development):
#   https://manage.formalie.dev:2202/api/v1/auth/oauth/{google|microsoft|facebook}/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=            # the App ID
OAUTH_FACEBOOK_CLIENT_SECRET=        # the App Secret
OAUTH_REDIRECT_BASE=                 # empty = https://manage.<ROOT_DOMAIN> on the port the browser used
EMAIL_ASSETS_URL=                    # Formalie mark images in emails; development: https://manage.formalie.dev:2202

# ── Files and exports ────────────────────────────────────────────────────────
STORAGE_DIR=data/storage             # development folder (git-ignored); object storage comes in B3
EXPORT_DOWNLOAD_MINUTES=10
EXPORT_MAX_ROWS=100000

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_FAIL_OPEN=true            # Redis down: allow and log CRITICAL (false = refuse with FRM-GEN-5003)

# ── Public form pages ────────────────────────────────────────────────────────
INTERNAL_TOKEN=                      # same value as NUXT_INTERNAL_TOKEN in the frontend (scripts/gen_keys.py); empty = /internal/* refused
LEGAL_TERMS_URL=https://formalie.com/terms
LEGAL_PRIVACY_URL=https://formalie.com/privacy

# ── Data sources (customers' own databases) ─────────────────────────────────
DATASOURCES_ALLOW_LOCAL=false        # development / tests only: let connections reach this machine (never in production)
WEBHOOKS_ALLOW_LOCAL=false           # development / tests only: let webhooks call http://localhost (never in production)
EGRESS_IPS=                          # Formalie's outgoing addresses customers allow in their firewall (comma separated)
TEST_MYSQL_URL=                      # tests: a MariaDB "customer" database (scripts/wsl/setup-mariadb.sh prints it)

# ── The public API service (api.<ROOT_DOMAIN>; app/gateway.py) ─────────────
GATEWAY_PORT=5005                    # `python -m app.gateway` (its own process); the main app also forwards api.<ROOT_DOMAIN>
GATEWAY_IP_PER_MINUTE=6000           # a ceiling per caller IP across all workspaces (each workspace sets its own limits)
API_NETWORKS_DIR=                    # empty = <GEOIP_DIR>/networks: vpn.txt, proxy.txt, tor.txt, hosting.txt (an IP or range per line)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=INFO
ALERT_EMAILS=                        # CRITICAL errors are emailed here (comma separated); empty = none
LOG_RETENTION_DAYS=90
LOG_CONSOLE=true
LOG_CONSOLE_FORMAT=                  # pretty (readable lines) or json; empty = pretty in development, json elsewhere

# ── Request log: every request in full (formaly.request_logs) ───────────────
REQUEST_LOG_ENABLED=true
REQUEST_LOG_SINK=database            # database (the API writes batches) | celery (the `logs` queue) | file
REQUEST_LOG_BODY_MAX_BYTES=65536     # bodies kept up to this size, hashed in full
REQUEST_LOG_RESPONSE_BODIES=errors   # none | errors | all
REQUEST_LOG_BATCH_SIZE=200
REQUEST_LOG_FLUSH_SECONDS=1.0
REQUEST_LOG_QUEUE_MAX=20000

# ── GeoIP: MaxMind GeoLite2 City + ASN (free account at maxmind.com) ────────
GEOIP_DIR=data/geoip
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
