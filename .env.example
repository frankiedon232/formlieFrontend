# Use the in-repo mock API (server/mock) instead of the FastAPI backend. Restart dev after changing.
NUXT_PUBLIC_API_MOCK=true

# Where /api/** is proxied when the mock is off (server-only).
NUXT_API_PROXY_TARGET=https://formalie.dev:5004

# Optional: mkcert files, so plain `pnpm dev` serves HTTPS on :2202 without CLI flags.
# DEV_HTTPS_CERT=C:/devcerts/formalie.pem
# DEV_HTTPS_KEY=C:/devcerts/formaliekey.pem

# Node must trust the mkcert root CA to proxy to the backend over HTTPS (find it with `mkcert -CAROOT`).
# NODE_EXTRA_CA_CERTS=C:/Users/<you>/AppData/Local/mkcert/rootCA.pem

# The website (formalieSite): its legal pages (/legal/{slug}) on public forms and sign-up, and the Enterprise enquiry.
# Development default https://formalie.dev:3033; production https://formalie.com (docs/PRODUCTION-CHECKLIST.md).
# NUXT_PUBLIC_SITE_URL=https://formalie.dev:3033
