# Formalie API settings. Copy to .env and fill in. Never commit .env.
# Read by app/core/config.py (pydantic-settings); names are case-insensitive.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | staging | production
APP_RELEASE=0.0.0-dev
DOCS_ENABLED=true                   # /docs and /redoc (always off in production)

# ── Hosts and tenancy ────────────────────────────────────────────────────────
ROOT_DOMAIN=formalie.dev
MANAGE_SUBDOMAIN=manage
# Peers allowed to set X-Forwarded-For / X-Forwarded-Host / CF-Connecting-IP (Nginx, the Nuxt dev proxy).
TRUSTED_PROXIES=127.0.0.1/32,::1/128
TENANT_CACHE_SECONDS=30

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Superuser, used ONLY by scripts/db_bootstrap.py to create the roles and databases below.
DB_SUPERUSER_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# The user names are fixed (migrations grant to them); choose the passwords.
DB_OWNER_URL=postgresql://formalie_owner:CHANGE_ME@127.0.0.1:5432/formalie       # Alembic only
DB_APP_URL=postgresql://formalie_app:CHANGE_ME@127.0.0.1:5432/formalie           # the API (primary)
DB_RELAY_URL=postgresql://formalie_worker:CHANGE_ME@127.0.0.1:5432/formalie      # outbox relay, partitions
# Read replicas, comma separated (empty = reads go to the primary). Same user as DB_APP_URL.
DB_REPLICA_URLS=
DB_SCHEMA=formaly                    # every workspace table; global tables are in `platform`; nothing in `public`
DB_TEST_DATABASE=formalie_test       # pytest and `alembic -x db=test`
DB_PGBOUNCER=false                   # true when connecting through PgBouncer (transaction pooling)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_READ_YOUR_WRITES_SECONDS=5

# ── Redis, RabbitMQ, Celery (WSL in development) ─────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
RABBITMQ_URL=amqp://formalie:CHANGE_ME@127.0.0.1:5672/formalie
EVENTS_EXCHANGE=formalie.events
OUTBOX_RELAY_BATCH=200

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_FAIL_OPEN=true            # Redis down: allow and log CRITICAL (false = refuse with FRM-GEN-5003)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
LOG_CONSOLE=true
