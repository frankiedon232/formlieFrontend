# Development values (docs/02-DEV-ENVIRONMENT.md). Production: docs/PRODUCTION-CHECKLIST.md, section 7.
NUXT_PUBLIC_SITE_URL=https://formalie.dev:3033
NUXT_PUBLIC_PORTAL_URL=https://manage.formalie.dev:2202
NUXT_PUBLIC_FORMS_URL=https://forms.formalie.dev:2202
NUXT_PUBLIC_API_URL=https://formalie.dev:5004/api/v1
# The development certificate, so `pnpm dev` serves https://formalie.dev:3033
DEV_HTTPS_CERT=C:/devcerts/formalie.pem
DEV_HTTPS_KEY=C:/devcerts/formalie-key.pem
# Lets the dev server and prerender trust the mkcert certificate of the local backend (Node 22.15+)
NODE_USE_SYSTEM_CA=1
